# ────────────────────────────────────────────
#  TecniDesk Backend — Variables de Entorno
#  Copia este archivo a .env y rellena los valores.
#  .env ejemplo para desarrollo local, no usar en producción sin revisar cada variable.
# ────────────────────────────────────────────

# PostgreSQL — Driver async para la app
DB_URL=postgresql+asyncpg://postgres.sdfsdfsfdsfsdsf:CAMBIENCONTRASEÑA@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# PostgreSQL — URL sync para CLI (psql, Alembic directo, smoke tests) (Riesgo 3)
DATABASE_URL=postgresql://postgres.sdfsdfsfdsfsdsf:CAMBIECONTRASEÑA@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# JWT — mínimo 64 caracteres aleatorios (usa: openssl rand -hex 32)
JWT_SECRET=CAMBIAR_POR_64_CHARS_ALEATORIOS_openssl_rand_hex_32
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_SECRETO_DIFERENTE_64_CHARS

# Súper-admin API Key para activar tiendas manualmente
SUPERADMIN_API_KEY=change-me-superadmin-secret-key

# Clave Fernet para cifrar pin_or_password (usa: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=shFNs1X7PoIZ9GFDFBXcoH0zHHHGOD7XS6M=

# bcrypt — work factor (D16). 10 = ~80ms en e2-micro, 12 = ~300ms en prod con más CPU
BCRYPT_ROUNDS=10

# Webhooks salientes
WEBHOOK_URL=https://tu-endpoint.example.com/webhook
WEBHOOK_SECRET=CAMBIAR_POR_SECRETO_WEBHOOK_64_CHARS

# Cloudflare R2
R2_ENDPOINT=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=CAMBIAR
R2_SECRET_KEY=CAMBIAR
R2_BUCKET_NAME=tec-evidencias

# CORS — Desarrollo local (dejar vacío en producción)
# Formato: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS_DEV=http://localhost:3000,http://localhost:5173
